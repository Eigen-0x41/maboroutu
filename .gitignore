# .gitignore

# whitelist mode

/*
!/.gitignore
!/.gitmodules
!/.editorconfig

#-allow list
#--cxx
!/include/
!/include/*
# !/include_disable/
# !/include_disable/*
!/lib/
!/lib/*
!/src/
!/src/*
!/test/
!/test/*


!/core/
!/core/*
!/extension/
!/extension/*
!/examples/
!/examples/*

!/.github/
!/.github/*

!/.clang-format
!/.clang-tidy
!/CMakeLists.txt
!/LICENSE
!/README.md

#--vcpkg
!/portfile.cmake
!/usage
!/vcpkg-configuration.json
!/vcpkg.json

#--github
!/.github/
!/.github/*
